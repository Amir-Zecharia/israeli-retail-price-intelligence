# Dashboard: dedicated SELECT-only role. Never use migration/admin credentials.
READ_DATABASE_URL=postgresql://irpi_dashboard:REPLACE_LOCALLY@HOST:5432/DATABASE?sslmode=require
# Pipeline only: dedicated ingestion role.
DATABASE_URL=postgresql://irpi_ingest:REPLACE_LOCALLY@HOST:5432/DATABASE?sslmode=require
# Tests only: disposable database; fixtures reset its schema.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irpi_test
